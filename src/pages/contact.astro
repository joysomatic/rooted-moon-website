---
// src/pages/contact.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";

const practitionerName = "Audrey Rees";
const practitionerCredentials =
    "LM · Licensed Midwife | CPM · Certified Professional Midwife | CST · Cranial Sacral Therapist";
const practitionerImagePath = "/practitioner.jpg";
---

<BaseLayout>
    <Navbar />

    <div class="pt-24 md:pt-32 px-6 flex-grow">
        <div class="mx-auto max-w-5xl">
            <section class="py-12 md:py-20">
                <span class="text-sm uppercase tracking-[0.3em] text-[#607264] font-semibold">
                    Get in Touch
                </span>
                <h1 class="text-3xl md:text-5xl font-bold mt-2 text-[#3c2f2f]">
                    Begin Your Journey
                </h1>

                <p class="text-lg md:text-xl text-[#607264] mt-3 max-w-xl italic">
                    “A journey of a thousand miles begins with a single step.” <span class="not-italic font-semibold">— Lao Tzu</span>
                </p>

                <div class="mt-12 grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
                    
                    <!-- Left Column: Practitioner Card -->
                    <div class="md:col-span-6 bg-[#f4f6f4] p-6 md:p-8 rounded-3xl border border-[#607264]/10 shadow-sm">
                        <div class="relative w-full aspect-[4/5] rounded-2xl overflow-hidden bg-[#e5eae6] border border-[#607264]/20 flex items-center justify-center">
                            <img
                                src={practitionerImagePath}
                                alt={practitionerName}
                                class="w-full h-full object-cover"
                                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                            />
                            <div class="hidden flex-col items-center justify-center text-[#607264] p-6 text-center">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="w-14 h-14 mb-3 opacity-60"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.5"
                                        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                                    ></path>
                                </svg>
                                <span class="text-sm font-semibold uppercase tracking-wider">Practitioner Photo Placeholder</span>
                                <span class="text-xs opacity-75 mt-1">Place photo in public/practitioner.jpg</span>
                            </div>
                        </div>

                        <div class="mt-6">
                            <h2 class="text-3xl font-bold text-[#3c2f2f]">
                                {practitionerName}
                            </h2>
                            <p class="text-base md:text-lg font-medium text-[#607264] mt-2 leading-relaxed">
                                {practitionerCredentials}
                            </p>
                        </div>
                    </div>

                    <!-- Right Column: Professional Contact Form -->
                    <div class="md:col-span-6 bg-[#f4f6f4] p-6 md:p-8 rounded-3xl border border-[#607264]/10 shadow-sm">
                        <div class="mb-6">
                            <h2 class="text-2xl font-bold text-[#3c2f2f]">Send a Message</h2>
                            <p class="text-sm text-[#607264] mt-1">Fill out the form below to get in touch.</p>
                        </div>

                        <form 
                            id="contact-form"
                            onsubmit="handleFormSubmit(event)"
                            class="space-y-4"
                        >
                            <div>
                                <label for="name" class="block text-xs uppercase tracking-wider text-[#607264] font-semibold mb-1">Your Name</label>
                                <input 
                                    type="text" 
                                    id="name" 
                                    name="name" 
                                    required 
                                    class="w-full px-4 py-3 rounded-xl bg-white border border-[#607264]/20 text-[#3c2f2f] focus:outline-none focus:border-[#1e2f23] transition-colors"
                                    placeholder="Jane Doe"
                                />
                            </div>

                            <div>
                                <label for="email" class="block text-xs uppercase tracking-wider text-[#607264] font-semibold mb-1">Email Address</label>
                                <input 
                                    type="email" 
                                    id="email" 
                                    name="email" 
                                    required 
                                    class="w-full px-4 py-3 rounded-xl bg-white border border-[#607264]/20 text-[#3c2f2f] focus:outline-none focus:border-[#1e2f23] transition-colors"
                                    placeholder="jane@example.com"
                                />
                            </div>

                            <div>
                                <label for="message" class="block text-xs uppercase tracking-wider text-[#607264] font-semibold mb-1">Message / Text</label>
                                <textarea 
                                    id="message" 
                                    name="message" 
                                    rows="4" 
                                    required 
                                    class="w-full px-4 py-3 rounded-xl bg-white border border-[#607264]/20 text-[#3c2f2f] focus:outline-none focus:border-[#1e2f23] transition-colors resize-none"
                                    placeholder="How can we help you on your journey?"
                                ></textarea>
                            </div>

                            <button 
                                type="submit" 
                                id="submit-btn"
                                class="w-full py-4 rounded-xl bg-[#1e2f23] text-white font-semibold uppercase tracking-wider hover:bg-[#3c2f2f] transition-all shadow-sm cursor-pointer"
                            >
                                Send Secure Message
                            </button>

                            <!-- Success Notification Container -->
                            <div id="form-success-message" class="hidden mt-4 p-4 rounded-xl bg-[#e5eae6] border border-[#607264]/30 text-[#1e2f23] text-center font-medium">
                                Thank you! Your message was successfully sent. Audrey will get back to you shortly.
                            </div>

                            <!-- Error Notification Container -->
                            <div id="form-error-message" class="hidden mt-4 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-center font-medium">
                                There was an error sending your message. Please try again.
                            </div>
                        </form>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <footer class="mt-20 border-t border-[#607264]/10 bg-[#f4f6f4] text-center text-sm md:text-base text-[#607264] py-8 px-6">
        <p>
            © 2026 Rooted Moon Medicinals. All Rights Reserved. Respecting the innate wisdom of the body.
        </p>
    </footer>

    <script is:inline>
        async function handleFormSubmit(event) {
            event.preventDefault();
            const form = event.target;
            const submitBtn = document.getElementById("submit-btn");
            const successDiv = document.getElementById("form-success-message");
            const errorDiv = document.getElementById("form-error-message");

            successDiv.classList.add("hidden");
            errorDiv.classList.add("hidden");
            submitBtn.disabled = true;
            submitBtn.textContent = "Sending...";

            const formData = {
                name: form.name.value,
                email: form.email.value,
                message: form.message.value,
            };

            try {
                const response = await fetch("/api/contact", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(formData),
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    form.reset();
                    successDiv.classList.remove("hidden");
                } else {
                    errorDiv.textContent = result.error || "There was an error sending your message.";
                    errorDiv.classList.remove("hidden");
                }
            } catch (error) {
                errorDiv.textContent = "Network error. Please check your connection.";
                errorDiv.classList.remove("hidden");
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = "Send Secure Message";
            }
        }
    </script>
</BaseLayout>