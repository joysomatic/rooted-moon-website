---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";

// Practitioner & Contact Info
const practitionerName = "Audrey Rees";
const practitionerCredentials = "LM · Licensed Midwife | CPM · Certified Professional Midwife | CST · Cranial Sacral Therapist";
const clientEmail = "audrey@rootedmoonmedicinals.com";
const clientPhone = "(707) 407-7657";
const formattedPhone = "tel:7074077657";

// Path to image inside the /public directory (e.g., /public/practitioner.jpg)
const practitionerImagePath = "/practitioner.jpg"; 
---

<BaseLayout>
  <Navbar />

  <div class="pt-24 md:pt-32 px-6 flex-grow">
    <div class="mx-auto max-w-5xl">
      <section class="py-12 md:py-20">
        <span class="text-xs uppercase tracking-[0.3em] text-[#607264] font-semibold">Get in Touch</span>
        <h1 class="text-3xl md:text-5xl font-bold mt-2 text-[#3c2f2f]">Begin Your Journey</h1>
        
        <!-- Replaced text with Quote keeping same space & fonts -->
        <p class="text-base text-[#607264] mt-2 max-w-xl italic">
          “A journey of a thousand miles begins with a single step.” <span class="not-italic font-semibold">— Lao Tzu</span>
        </p>

        <!-- Professional Profile & Contact Grid -->
        <div class="mt-12 grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
          
          <!-- Left Column: Practitioner Card -->
          <div class="md:col-span-6 bg-[#f4f6f4] p-6 md:p-8 rounded-3xl border border-[#607264]/10 shadow-sm">
            
            <!-- Image Placeholder Frame -->
            <div class="relative w-full aspect-[4/5] rounded-2xl overflow-hidden bg-[#e5eae6] border border-[#607264]/20 flex items-center justify-center">
              <img 
                src={practitionerImagePath} 
                alt={practitionerName} 
                class="w-full h-full object-cover"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <!-- Fallback SVG shown if no local image is found yet -->
              <div class="hidden flex-col items-center justify-center text-[#607264] p-4 text-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 mb-2 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <span class="text-xs font-semibold uppercase tracking-wider">Practitioner Photo Placeholder</span>
                <span class="text-[11px] opacity-75 mt-1">Place photo in public/practitioner.jpg</span>
              </div>
            </div>

            <!-- Practitioner Details -->
            <div class="mt-6">
              <h2 class="text-2xl font-bold text-[#3c2f2f]">{practitionerName}</h2>
              <p class="text-sm font-medium text-[#607264] mt-1">{practitionerCredentials}</p>
            </div>
          </div>

          <!-- Right Column: Direct Action Contact Cards -->
          <div class="md:col-span-6 space-y-6">
            
            <!-- Email Action Card -->
            <a 
              href={`mailto:${clientEmail}`}
              class="flex items-center gap-5 bg-[#f4f6f4] p-6 rounded-2xl border border-[#607264]/10 shadow-sm hover:border-[#1e2f23]/30 transition-all group"
            >
              <div class="w-12 h-12 rounded-xl bg-[#1e2f23] text-white flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="text-xs uppercase tracking-wider text-[#607264] font-semibold">Email Directly</p>
                <p class="text-lg font-bold text-[#1e2f23] group-hover:text-[#607264] transition-colors mt-0.5">
                  {clientEmail}
                </p>
              </div>
            </a>

            <!-- Phone Action Card -->
            <a 
              href={formattedPhone}
              class="flex items-center gap-5 bg-[#f4f6f4] p-6 rounded-2xl border border-[#607264]/10 shadow-sm hover:border-[#1e2f23]/30 transition-all group"
            >
              <div class="w-12 h-12 rounded-xl bg-[#1e2f23] text-white flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <p class="text-xs uppercase tracking-wider text-[#607264] font-semibold">Call or Text</p>
                <p class="text-lg font-bold text-[#1e2f23] group-hover:text-[#607264] transition-colors mt-0.5">
                  {clientPhone}
                </p>
              </div>
            </a>

          </div>

        </div>
      </section>
    </div>
  </div>

  <footer class="mt-20 border-t border-[#607264]/10 bg-[#f4f6f4] text-center text-xs md:text-sm text-[#607264] py-8 px-6">
    <p>© 2026 Rooted Moon Medicinals. All Rights Reserved. Respecting the innate wisdom of the body.</p>
  </footer>
</BaseLayout>