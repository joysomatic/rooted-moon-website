---
---
<nav class="fixed top-0 left-0 right-0 z-50 bg-[#faf8f5]/80 backdrop-blur-xl border-b border-[#607264]/10">
  <div class="max-w-5xl mx-auto flex items-center justify-between px-6 py-4">
    
    <a href="#top" class="text-xl md:text-2xl font-semibold tracking-wide text-[#1e2f23]">
      Rooted Moon <span class="font-normal italic text-[#607264]">Medicinals</span>
    </a>

    <button
      id="menu-toggle"
      class="md:hidden flex flex-col justify-center items-center w-8 h-8 space-y-1.5 focus:outline-none"
      aria-label="Toggle Menu"
    >
      <span class="block w-6 h-0.5 bg-[#1e2f23] transition-all duration-300"></span>
      <span class="block w-6 h-0.5 bg-[#1e2f23] transition-all duration-300"></span>
      <span class="block w-6 h-0.5 bg-[#1e2f23] transition-all duration-300"></span>
    </button>

    <div
      id="mobile-menu"
      class="absolute top-full left-0 w-full overflow-hidden max-h-0 transition-all duration-500 ease-in-out bg-[#faf8f5]/95 md:static md:max-h-none md:w-auto md:bg-transparent"
    >
      <div class="flex flex-col md:flex-row items-center gap-y-4 gap-x-2 px-6 py-8 md:py-0 text-center">
        <a href="#top" class="nav-link px-4 py-2 text-sm font-medium text-[#1e2f23] hover:text-[#607264] transition-colors">Home</a>
        <a href="#homebirth" class="nav-link px-4 py-2 text-sm font-medium text-[#1e2f23] hover:text-[#607264] transition-colors">Home Birth</a>
        <a href="#bodywork" class="nav-link px-4 py-2 text-sm font-medium text-[#1e2f23] hover:text-[#607264] transition-colors">Bodywork</a>
        <a href="#apothecary" class="nav-link px-4 py-2 text-sm font-medium text-[#1e2f23] hover:text-[#607264] transition-colors">Apothecary</a>
        <a href="#about" class="nav-link px-4 py-2 text-sm font-medium text-[#1e2f23] hover:text-[#607264] transition-colors">Who I Am</a>
        <a href="#contact" class="nav-link ml-0 md:ml-4 px-5 py-2 text-sm font-semibold tracking-wide text-white bg-[#1e2f23] rounded-full hover:bg-[#607264] transition-all duration-200">Connect</a>
      </div>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const links = document.querySelectorAll(".nav-link");

  function toggleMenu() {
    if (!menu) return;
    const isOpening = !menu.style.maxHeight || menu.style.maxHeight === "0px";
    menu.style.maxHeight = isOpening ? `${menu.scrollHeight}px` : "0px";
  }

  btn?.addEventListener("click", toggleMenu);
  links.forEach(link => link.addEventListener("click", () => {
    if (window.innerWidth < 768) toggleMenu();
  }));
</script>